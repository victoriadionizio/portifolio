-- 1.Consulta que retorna pedidos com detalhes do cliente e produtos comprados
SELECT 
    o.order_id,
    c.first_name,
    c.last_name,
    p.product_name,
    oi.quantity, 
    oi.unit_price,
    oi.total_price,
    o.total_amount,
    o.order_date,
    o.status
FROM Orders o
JOIN Customers c ON o.customer_id = c.customer_id
JOIN OrderItems oi ON o.order_id = oi.order_id
JOIN Products p ON oi.product_id = p.product_id
ORDER BY o.order_date DESC;

-- 2.Consulta que retorna pedidos pendentes para envio, com detalhes do cliente e endereço de entrega
SELECT 
    o.order_id,
    c.first_name,
    c.last_name,
    o.shipping_address,
    o.shipping_city,
    o.shipping_state,
    o.shipping_postal_code,
    o.total_amount,
    o.order_date
FROM Orders o
JOIN Customers c ON o.customer_id = c.customer_id
WHERE o.status = 'Pending'
ORDER BY o.order_date ASC;

-- 3.Consulta que retorna o total de vendas (quantidade e valor) por produto
SELECT 
    p.product_name,
    SUM(oi.quantity) AS total_quantity_sold,
    SUM(oi.total_price) AS total_sales
FROM OrderItems oi
JOIN Products p ON oi.product_id = p.product_id
GROUP BY p.product_name 
ORDER BY total_sales DESC;

-- 4.Consulta que retorna os 5 clientes com maior número de pedidos
SELECT 
    c.customer_id,
    c.first_name,
    c.last_name,
    COUNT(o.order_id) AS total_orders
FROM Customers c
JOIN Orders o ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.first_name, c.last_name
ORDER BY total_orders DESC
LIMIT 5; 

-- 5.Consulta que retorna produtos com estoque inferior a um limite
SELECT 
    p.product_id,
    p.product_name,
    p.stock_quantity,
    p.price 
FROM Products p
WHERE p.stock_quantity < 10
ORDER BY p.stock_quantity ASC;

-- 6.Consulta que retorna pedidos completos com o total de itens comprados
SELECT 
    o.order_id,
    COUNT(oi.order_item_id) AS total_items,
    SUM(oi.total_price) AS total_order_value,
    o.order_date
FROM Orders o
JOIN OrderItems oi ON o.order_id = oi.order_id
WHERE o.status = 'Completed'
GROUP BY o.order_id, o.order_date
ORDER BY o.order_date DESC;

-- 7.Consulta que retorna clientes que não fizeram nenhum pedido
SELECT 
    c.customer_id,
    c.first_name,
    c.last_name,
    c.email
FROM Customers c
LEFT JOIN Orders o ON c.customer_id = o.customer_id
WHERE o.order_id IS NULL;

-- 8.Consulta que retorna os produtos mais vendidos por mês em um intervalo de tempo
SELECT 
    p.product_name,
    DATE_FORMAT(o.order_date, '%Y-%m') AS order_month,
    SUM(oi.quantity) AS total_quantity_sold,
    SUM(oi.total_price) AS total_sales
FROM OrderItems oi
JOIN Orders o ON oi.order_id = o.order_id
JOIN Products p ON oi.product_id = p.product_id
WHERE o.order_date BETWEEN '1993-12-01' AND '2019-09-11'
GROUP BY p.product_name, order_month
ORDER BY order_month ASC, total_sales DESC;
