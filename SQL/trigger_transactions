INSERT INTO transactions (account_id, amount, transaction_type) 
VALUES (1, 200.00, 'deposit');

-- Verificando o saldo atualizado
SELECT * FROM accounts WHERE id = 1;

-- Realizando um saque
INSERT INTO transactions (account_id, amount, transaction_type) 
VALUES (1, 100.00, 'withdrawal');

-- Verificando o saldo atualizado
SELECT * FROM accounts WHERE id = 1;

--Garantir que nenhum saque possa ser realizado se o saldo da conta for insuficiente.
CREATE TRIGGER before_transaction_insert
BEFORE INSERT ON transactions
FOR EACH ROW
BEGIN
    IF NEW.transaction_type = 'withdrawal' THEN
        DECLARE current_balance DECIMAL(10, 2);
        SELECT saldo INTO current_balance
        FROM accounts
        WHERE id = NEW.account_id;

        IF current_balance < NEW.amount THEN
            SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Saldo insuficiente para esta transação.';
        END IF;
    END IF;
END;

