-- Criação da tabela de Clientes
CREATE TABLE Customers (
    customer_id INT PRIMARY KEY AUTO_INCREMENT,  -- ID único do cliente (Chave Primária) gerado automaticamente
    first_name VARCHAR(50) NOT NULL,             -- Nome do cliente, campo obrigatório
    last_name VARCHAR(50) NOT NULL,              -- Sobrenome do cliente, campo obrigatório
    email VARCHAR(100) UNIQUE NOT NULL,          -- Email do cliente, único e obrigatório
    phone_number VARCHAR(20),                    -- Número de telefone do cliente (opcional)
    address VARCHAR(255),                        -- Endereço do cliente (opcional)
    city VARCHAR(100),                           -- Cidade do cliente (opcional)
    state VARCHAR(50),                           -- Estado do cliente (opcional)
    country VARCHAR(50),                         -- País do cliente (opcional)
    postal_code VARCHAR(10),                     -- Código postal do cliente (opcional)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- Data e hora de criação do cliente, com valor padrão de data atual
);

-- Criação da tabela de Produtos
CREATE TABLE Products (
    product_id INT PRIMARY KEY AUTO_INCREMENT,   -- ID único do produto (Chave Primária) gerado automaticamente
    product_name VARCHAR(100) NOT NULL,          -- Nome do produto, campo obrigatório
    product_description TEXT,                    -- Descrição do produto (opcional)
    price DECIMAL(10, 2) NOT NULL,               -- Preço do produto, campo obrigatório
    stock_quantity INT NOT NULL DEFAULT 0,       -- Quantidade em estoque, valor padrão é 0
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- Data e hora de criação do produto, com valor padrão de data atual
);

-- Criação da tabela de Pedidos
CREATE TABLE Orders (
    order_id INT PRIMARY KEY AUTO_INCREMENT,     -- ID único do pedido (Chave Primária) gerado automaticamente
    customer_id INT NOT NULL,                    -- ID do cliente (Chave Estrangeira), campo obrigatório
    order_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- Data do pedido, valor padrão é a data atual
    total_amount DECIMAL(10, 2) NOT NULL,        -- Valor total do pedido, campo obrigatório
    status VARCHAR(50) NOT NULL DEFAULT 'Pending', -- Status do pedido, valor padrão é 'Pending'
    shipping_address VARCHAR(255),               -- Endereço de entrega (opcional)
    shipping_city VARCHAR(100),                  -- Cidade de entrega (opcional)
    shipping_state VARCHAR(50),                  -- Estado de entrega (opcional)
    shipping_country VARCHAR(50),                -- País de entrega (opcional)
    shipping_postal_code VARCHAR(10),            -- Código postal de entrega (opcional)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- Data e hora de criação do pedido, com valor padrão de data atual
    -- Definindo uma chave estrangeira que se refere ao campo customer_id da tabela Customers.
    -- O 'ON DELETE CASCADE' significa que se um cliente for deletado, os pedidos dele também serão deletados.
    CONSTRAINT fk_customer FOREIGN KEY (customer_id) 
        REFERENCES Customers(customer_id) 
        ON DELETE CASCADE ON UPDATE CASCADE
);

-- Criação da tabela de Itens do Pedido
CREATE TABLE OrderItems (
    order_item_id INT PRIMARY KEY AUTO_INCREMENT, -- ID único do item do pedido (Chave Primária) gerado automaticamente
    order_id INT NOT NULL,                        -- ID do pedido (Chave Estrangeira), campo obrigatório
    product_id INT NOT NULL,                      -- ID do produto (Chave Estrangeira), campo obrigatório
    quantity INT NOT NULL,                        -- Quantidade do produto no pedido, campo obrigatório
    unit_price DECIMAL(10, 2) NOT NULL,           -- Preço unitário do produto, campo obrigatório
    -- Definindo uma coluna calculada que multiplica a quantidade pelo preço unitário
    total_price AS (quantity * unit_price) STORED, -- Preço total (calculado automaticamente)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- Data e hora de criação do item do pedido, com valor padrão de data atual
    -- Definindo a chave estrangeira para a tabela Orders.
    -- O 'ON DELETE CASCADE' garante que os itens de um pedido sejam excluídos quando o pedido for deletado.
    CONSTRAINT fk_order FOREIGN KEY (order_id) 
        REFERENCES Orders(order_id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    -- Definindo a chave estrangeira para a tabela Products.
    -- O 'ON DELETE CASCADE' garante que os itens relacionados ao produto sejam excluídos quando o produto for deletado.
    CONSTRAINT fk_product FOREIGN KEY (product_id) 
        REFERENCES Products(product_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

-- ÍNDICES (OTIMIZAÇÃO DE CONSULTAS)
-- Criação de um índice para otimizar consultas que envolvem o status e a data do pedido.
CREATE INDEX idx_order_status_date ON Orders (status, order_date);

-- Criação de um índice para otimizar consultas relacionadas ao email dos clientes (campo único).
CREATE INDEX idx_customer_email ON Customers (email);

-- Criação de um índice para otimizar consultas envolvendo o nome dos produtos.
CREATE INDEX idx_product_name ON Products (product_name);
